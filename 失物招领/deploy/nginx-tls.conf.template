server {
    listen 80;
    server_name ${TLS_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 308 ${BASE_URL}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${TLS_DOMAIN};
    ssl_certificate /etc/nginx/tls/live/${TLS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/live/${TLS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        include /etc/nginx/snippets/proxy.conf;
    }
}
