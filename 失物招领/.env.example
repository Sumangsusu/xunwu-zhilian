# 公网演示默认值。deploy/deploy.sh 会替换 SESSION_SECRET。
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_PATH=data/xunwu.db
SESSION_SECRET=
BASE_URL=
TRUST_PROXY=1
IMAGE_STORE=file
SEED_DEV_USER=false
CAS_ENABLED=false
CAS_BASE_URL=
CORS_ORIGIN=
RATE_LIMIT=20
# 地图：key 与实测 GCJ-02 中心点由部署方填写，留空则前端降级自绘 SVG
MAP_KEY=
MAP_SDK_URL=
MAP_CENTER_LNG=
MAP_CENTER_LAT=
MAP_ZOOM=
# 文字识别：密钥只在后端，留空则接口返回「未启用」的友好提示
OCR_SECRET_ID=
OCR_SECRET_KEY=
OCR_REGION=
CAMPUS_CALIBRATION=data/campus-calibration.json
HTTP_PORT=80
HTTPS_PORT=443
TLS_DOMAIN=
TLS_CERT_DIR=./deploy/certs
