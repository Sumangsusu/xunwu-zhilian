# ============ 寻物智联 环境变量示例 ============
# 复制为 .env 后填写真实值；.env 必须加入 .gitignore，切勿提交真实密钥。

# 服务端口
PORT=3000

# 会话 Cookie 签名密钥（生产必须改为强随机值，例如 openssl rand -hex 32 的输出）
SESSION_SECRET=change-me-to-a-long-random-string
# 会话有效期（秒），默认 8 小时
SESSION_MAX_AGE=28800

# ---- 武汉大学统一身份认证（CAS）----
# 是否启用整站门禁：true 时，打开网站未登录会自动跳转到武大统一认证（智慧珞珈）登录页，
# 认证通过才放行进站；任何页面/接口未登录访问都会被拦截。
# 注意：完整单点登录需先在学校的网络资产备案系统登记 service 回调并拿到测试账号。
# 在没有学校资产、仅想本地预览/调试 UI 时，可临时设为 false（此时用本地密码登录）。
CAS_ENABLED=true
# CAS 服务地址（学校提供，通常为下方默认值）
CAS_BASE_URL=https://cas.whu.edu.cn/authserver
# 你的站点对外地址（HTTPS），CAS 回调与统一注销依赖此值。
# 上线必填，例如：BASE_URL=https://xunwu.whu.edu.cn
# 留空时服务会回退到「当前请求的 host」，便于在 localhost 上先验证跳转效果（但无法完成真实登录）。
BASE_URL=
# CAS 断言返回的学工号中，哪些直接赋予管理员角色（逗号分隔）
# 例如：ADMIN_STUDENT_IDS=202011800000,202011800001
ADMIN_STUDENT_IDS=

# ---- 本地开发 ----
# 是否写入演示/管理员账号与演示数据（生产置 false）
SEED_DEV_USER=true

# ---- 数据库（route B 上线时由学校实例替换）----
# sqlite | mysql | postgres（当前代码默认 sqlite，切换需对应改 db 连接层）
DB_TYPE=sqlite

# ---- 图片存储 ----
# db（base64 入库，默认）| file（随机文件名落盘）
IMAGE_STORE=db
# 仅 IMAGE_STORE=file 时生效
UPLOAD_DIR=public/uploads
# 单张图片上限（字节），默认 2MB
MAX_IMAGE_BYTES=2097152
